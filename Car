#include <Servo.h>

// =====================================================
// Hardware map
// =====================================================

enum Side {
  LEFT_SIDE = 0,
  FRONT_SIDE = 1,
  RIGHT_SIDE = 2
};

const byte IR_LED_PIN[3] = {
  10,   // left
  6,    // front / middle
  2     // right
};

const byte IR_RX_PIN[3] = {
  11,   // left
  7,    // front / middle
  3     // right
};

const byte DEBUG_LED_PIN[3] = {
  A2,   // left LED
  A1,   // middle LED
  A0    // right LED
};

const byte LEFT_SERVO_PIN = 12;
const byte RIGHT_SERVO_PIN = 13;

Servo leftServo;
Servo rightServo;


// =====================================================
// Movement and sensor tuning
// =====================================================

const int SERVO_STOP_US = 1500;
const int LEFT_SERVO_TRIM = -10;

const int DRIVE_SPEED = 60;

const int SOFT_CORRECTION = -6;
const int STRONG_CORRECTION = -30;

const int TURN_LEFT_90_MS = 497;
const int TURN_RIGHT_90_MS = 517;

const int SIDE_WALL_LIMIT = 6;
const int FRONT_WALL_LIMIT = SIDE_WALL_LIMIT - 2;


// =====================================================
// Navigation timing values
// =====================================================

const unsigned long START_IGNORE_TURNS_MS = 700;

const int OPENING_CONFIRM_LIMIT = 2;

const int SIDE_OPEN_FORWARD_ALIGN_MS = 900;
const int FRONT_BLOCKED_ALIGN_MS = 241;

const int JUNCTION_ALIGN_SPEED = 60;

const int AFTER_TURN_FORWARD_MS = 1051;

const int T_RECHECK_FORWARD_MS = 150;

const int UNUSED_BACKUP_BEFORE_UTURN_MS = 260;

const int UTURN_SPIN_SPEED = 250;
const int UTURN_SPIN_MS = 980;

const unsigned long LONG_DEAD_END_MS = 1400;


// =====================================================
// Navigation memory
// =====================================================

unsigned long robotStartMs = 0;

unsigned long possibleDeadEndStartMs = 0;
bool timingNarrowCorridor = false;

char previousTurn = ' ';
bool uTurnJustMade = false;

bool ignoreSideEdges = false;
bool sawOpenAreaAfterUTurn = false;

int leftOpenSeen = 0;
int rightOpenSeen = 0;


// =====================================================
// Sensor packet
// =====================================================

struct Walls {
  int raw[3];
  bool blocked[3];
};


// =====================================================
// Servo control
// =====================================================

void writeDrive(int leftSpeed, int rightSpeed) {
  int leftPulse = SERVO_STOP_US - leftSpeed - LEFT_SERVO_TRIM;
  int rightPulse = SERVO_STOP_US + rightSpeed;

  leftServo.writeMicroseconds(leftPulse);
  rightServo.writeMicroseconds(rightPulse);

  Serial.print("servo_1: ");
  Serial.print(leftPulse);
  Serial.print(" | servo_2: ");
  Serial.println(rightPulse);
}

void driveAhead(int speed) {
  writeDrive(speed, speed);
}

void driveBack(int speed) {
  writeDrive(-speed, -speed);
}

void brakeRobot() {
  leftServo.writeMicroseconds(SERVO_STOP_US);
  rightServo.writeMicroseconds(SERVO_STOP_US + 3);
  Serial.println("STOP");
}

void spinRobot(char direction, int speed) {
  int sign = (direction == 'R') ? 1 : -1;

  int leftPulse = SERVO_STOP_US + sign * speed - LEFT_SERVO_TRIM;
  int rightPulse = SERVO_STOP_US + sign * speed;

  leftServo.writeMicroseconds(leftPulse);
  rightServo.writeMicroseconds(rightPulse);

  if (direction == 'R') {
    Serial.println("TURN RIGHT IN PLACE");
  } else {
    Serial.println("TURN LEFT IN PLACE");
  }
}

void clearOpeningCounters() {
  leftOpenSeen = 0;
  rightOpenSeen = 0;
  timingNarrowCorridor = false;
}

void quarterTurn(char direction) {
  if (direction == 'L') {
    spinRobot('L', 200);
    delay(TURN_LEFT_90_MS);
  } else {
    spinRobot('R', 200);
    delay(TURN_RIGHT_90_MS);
  }

  brakeRobot();
  delay(80);

  clearOpeningCounters();
}

void rotateBack() {
  Serial.println("U-TURN");

  spinRobot('L', UTURN_SPIN_SPEED);
  delay(UTURN_SPIN_MS);

  brakeRobot();
  delay(100);

  clearOpeningCounters();
}

void enterNewCorridor() {
  driveAhead(100);
  delay(AFTER_TURN_FORWARD_MS);

  brakeRobot();
  delay(60);
}


// =====================================================
// IR reading
// =====================================================

int readIRPulse(byte ledPin, byte receiverPin, long frequency) {
  tone(ledPin, frequency);
  delay(1);

  int value = digitalRead(receiverPin);

  noTone(ledPin);
  delay(1);

  return value;
}

int measureIR(byte side) {
  int total = 0;

  for (long freq = 37000; freq <= 42000; freq += 1000) {
    total += readIRPulse(IR_LED_PIN[side], IR_RX_PIN[side], freq);
  }

  if (total < SIDE_WALL_LIMIT) {
    digitalWrite(DEBUG_LED_PIN[side], HIGH);
  } else {
    digitalWrite(DEBUG_LED_PIN[side], LOW);
  }

  return total;
}

Walls scanMaze() {
  Walls w;

  for (byte i = 0; i < 3; i++) {
    w.raw[i] = measureIR(i);
  }

  w.blocked[LEFT_SIDE] = w.raw[LEFT_SIDE] < SIDE_WALL_LIMIT;
  w.blocked[FRONT_SIDE] = w.raw[FRONT_SIDE] < FRONT_WALL_LIMIT;
  w.blocked[RIGHT_SIDE] = w.raw[RIGHT_SIDE] < SIDE_WALL_LIMIT;

  Serial.print("L: ");
  Serial.print(w.raw[LEFT_SIDE]);
  Serial.print(" | M: ");
  Serial.print(w.raw[FRONT_SIDE]);
  Serial.print(" | R: ");
  Serial.println(w.raw[RIGHT_SIDE]);

  return w;
}


// =====================================================
// Corridor balancing
// =====================================================

void keepMiddleOfCorridor(const Walls &w) {
  int leftScore = w.raw[LEFT_SIDE];
  int rightScore = w.raw[RIGHT_SIDE];

  int offset = leftScore - rightScore;

  Serial.print("Left distance: ");
  Serial.print(leftScore);
  Serial.print(" | Right distance: ");
  Serial.print(rightScore);
  Serial.print(" | Difference: ");
  Serial.println(offset);

  if (offset <= -3) {
    Serial.println("Too close to LEFT wall -> steer right");
    writeDrive(DRIVE_SPEED + STRONG_CORRECTION,
               DRIVE_SPEED - STRONG_CORRECTION);
  }

  else if (offset == -2) {
    Serial.println("Slightly close to LEFT wall -> small steer right");
    writeDrive(DRIVE_SPEED + SOFT_CORRECTION,
               DRIVE_SPEED - SOFT_CORRECTION);
  }

  else if (offset >= 3) {
    Serial.println("Too close to RIGHT wall -> steer left");
    writeDrive(DRIVE_SPEED - STRONG_CORRECTION,
               DRIVE_SPEED + STRONG_CORRECTION);
  }

  else if (offset == 2) {
    Serial.println("Slightly close to RIGHT wall -> small steer left");
    writeDrive(DRIVE_SPEED - SOFT_CORRECTION,
               DRIVE_SPEED + SOFT_CORRECTION);
  }

  else {
    Serial.println("Centered -> move forward");
    driveAhead(DRIVE_SPEED);
  }
}


// =====================================================
// Dead-end timing
// =====================================================

void refreshDeadEndTimer(const Walls &w) {
  bool narrowOpenCorridor =
    w.blocked[LEFT_SIDE] &&
    w.blocked[RIGHT_SIDE] &&
    !w.blocked[FRONT_SIDE];

  if (narrowOpenCorridor) {
    if (!timingNarrowCorridor) {
      possibleDeadEndStartMs = millis();
      timingNarrowCorridor = true;
      Serial.println("Entered possible dead-end corridor -> timer started");
    }
  }

  else if (!w.blocked[FRONT_SIDE]) {
    timingNarrowCorridor = false;
  }
}


// =====================================================
// Turn sequences
// =====================================================

void alignAndTurn(char direction, bool frontIsBlocked) {
  if (direction == 'L') {
    Serial.println("Align then turn LEFT");
  } else {
    Serial.println("Align then turn RIGHT");
  }

  driveAhead(JUNCTION_ALIGN_SPEED);

  if (frontIsBlocked) {
    delay(FRONT_BLOCKED_ALIGN_MS);
  } else {
    delay(SIDE_OPEN_FORWARD_ALIGN_MS);
  }

  brakeRobot();
  delay(80);

  previousTurn = direction;

  quarterTurn(direction);
  enterNewCorridor();
}


// =====================================================
// Dead-end response
// =====================================================

void resolveDeadEnd() {
  brakeRobot();
  delay(80);

  unsigned long elapsed = millis() - possibleDeadEndStartMs;

  Serial.print("Dead end! Time in corridor: ");
  Serial.print(elapsed);
  Serial.println(" ms");

  if (timingNarrowCorridor && elapsed >= LONG_DEAD_END_MS) {
    Serial.println("LONG dead end -> STOP (finish area)");
    brakeRobot();

    while (true) {
    }
  }

  Serial.println("SHORT dead end -> reverse then U-turn");

  timingNarrowCorridor = false;
  uTurnJustMade = true;

  ignoreSideEdges = true;
  sawOpenAreaAfterUTurn = false;

  brakeRobot();
  delay(80);

  rotateBack();

  driveAhead(100);
  delay(220);
}


// =====================================================
// U-turn side-edge suppression
// =====================================================

bool continueAfterUTurnIfNeeded(const Walls &w) {
  if (!ignoreSideEdges) {
    return false;
  }

  bool eitherSideOpen =
    !w.blocked[LEFT_SIDE] ||
    !w.blocked[RIGHT_SIDE];

  if (eitherSideOpen) {
    sawOpenAreaAfterUTurn = true;
    Serial.println("Post-U-turn: open junction area detected");
  }

  bool returnedToWalledCorridor =
    sawOpenAreaAfterUTurn &&
    w.blocked[LEFT_SIDE] &&
    w.blocked[RIGHT_SIDE];

  if (returnedToWalledCorridor) {
    ignoreSideEdges = false;
    sawOpenAreaAfterUTurn = false;
    Serial.println("Edge detection re-enabled -> back in walled corridor");
    return false;
  }

  if (!w.blocked[FRONT_SIDE]) {
    driveAhead(DRIVE_SPEED);
    return true;
  }

  return false;
}


// =====================================================
// T-junction confirmation
// =====================================================

void inspectTJunction() {
  Serial.println("Possible T-junction -> creeping forward to confirm");

  driveAhead(80);
  delay(T_RECHECK_FORWARD_MS);

  brakeRobot();
  delay(80);

  Walls check = scanMaze();

  bool leftBlocked = check.blocked[LEFT_SIDE];
  bool frontBlocked = check.blocked[FRONT_SIDE];
  bool rightBlocked = check.blocked[RIGHT_SIDE];

  if (frontBlocked && rightBlocked && !leftBlocked) {
    Serial.println("Confirmed: left turn corner");
    previousTurn = 'L';

    quarterTurn('L');
    enterNewCorridor();
  }

  else if (frontBlocked && leftBlocked && !rightBlocked) {
    Serial.println("Confirmed: right turn corner");
    previousTurn = 'R';

    quarterTurn('R');
    enterNewCorridor();
  }

  else if (frontBlocked && !leftBlocked && !rightBlocked) {
    Serial.println("Confirmed: true T-junction");

    if (uTurnJustMade && previousTurn == 'L') {
      Serial.println("Post U-turn: last was LEFT -> turn LEFT again");

      quarterTurn('L');
      previousTurn = 'L';
      uTurnJustMade = false;
    }

    else if (uTurnJustMade && previousTurn == 'R') {
      Serial.println("Post U-turn: last was RIGHT -> turn RIGHT again");

      quarterTurn('R');
      previousTurn = 'R';
      uTurnJustMade = false;
    }

    else {
      Serial.println("No U-turn context -> default turn LEFT");

      quarterTurn('L');
      previousTurn = 'L';
    }

    enterNewCorridor();
  }

  else if (frontBlocked && leftBlocked && rightBlocked) {
    Serial.println("Confirmed: dead end after creep -> next loop handles it");
  }
}


// =====================================================
// Startup
// =====================================================

void setup() {
  for (byte i = 0; i < 3; i++) {
    pinMode(IR_LED_PIN[i], OUTPUT);
    pinMode(IR_RX_PIN[i], INPUT);
    pinMode(DEBUG_LED_PIN[i], OUTPUT);
  }

  Serial.begin(9600);

  leftServo.attach(LEFT_SERVO_PIN);
  rightServo.attach(RIGHT_SERVO_PIN);

  brakeRobot();

  robotStartMs = millis();
}


// =====================================================
// Main behaviour dispatcher
// =====================================================

void loop() {
  Walls current = scanMaze();

  refreshDeadEndTimer(current);

  bool leftIsOpen = !current.blocked[LEFT_SIDE];
  bool frontIsOpen = !current.blocked[FRONT_SIDE];
  bool rightIsOpen = !current.blocked[RIGHT_SIDE];

  bool allBlocked =
    current.blocked[LEFT_SIDE] &&
    current.blocked[FRONT_SIDE] &&
    current.blocked[RIGHT_SIDE];

  if (allBlocked) {
    resolveDeadEnd();
    return;
  }

  if (continueAfterUTurnIfNeeded(current)) {
    return;
  }

  bool stillInStartupLockout =
    millis() - robotStartMs < START_IGNORE_TURNS_MS;

  if (stillInStartupLockout && frontIsOpen) {
    Serial.println("Start lockout -> forward only");
    keepMiddleOfCorridor(current);
    return;
  }

  bool canUseSideOpenings = !ignoreSideEdges;

  if (current.blocked[RIGHT_SIDE] && leftIsOpen && canUseSideOpenings) {
    leftOpenSeen++;
    rightOpenSeen = 0;

    Serial.print("Left opening count: ");
    Serial.println(leftOpenSeen);

    if (leftOpenSeen >= OPENING_CONFIRM_LIMIT) {
      alignAndTurn('L', current.blocked[FRONT_SIDE]);
      leftOpenSeen = 0;
      return;
    }
  }

  else {
    leftOpenSeen = 0;
  }

  if (current.blocked[LEFT_SIDE] && rightIsOpen && canUseSideOpenings) {
    rightOpenSeen++;
    leftOpenSeen = 0;

    Serial.print("Right opening count: ");
    Serial.println(rightOpenSeen);

    if (rightOpenSeen >= OPENING_CONFIRM_LIMIT) {
      alignAndTurn('R', current.blocked[FRONT_SIDE]);
      rightOpenSeen = 0;
      return;
    }
  }

  else {
    rightOpenSeen = 0;
  }

  if (frontIsOpen) {
    keepMiddleOfCorridor(current);
    return;
  }

  if (current.blocked[FRONT_SIDE] && leftIsOpen && rightIsOpen) {
    inspectTJunction();
    return;
  }

  Serial.println("No condition matched -> stop for safety");
  brakeRobot();
}
